if [ x$ACT_HOME = x ]
then
	echo "Please set the environment variable ACT_HOME to the install directory"
        exit 1
fi

if [ x$EDA_SRC = x ]
then
	export EDA_SRC=$(pwd)/src
fi

if [ x$BUILD_GUI = x ]
then
        echo
	echo "Building without GUI applications, to enable set BUILD_GUI='true' and have X11 and libGLU istalled"
        echo
fi

# -j for all build scripts. A runner can hold far less RAM per core than a compile or
# link needs (~2GB for the heavy c++ TUs), then an unbounded -j OOM-kills cc1plus/ld,
# so MAKE_JOBS is set per runner in .gitlab-ci.yml; nproc when unset. The report below
# shows what the runner really grants - nproc and _PHYS_PAGES ignore cgroup limits.
: ${MAKE_JOBS:=$(nproc)}
export MAKE_JOBS
CG_MEM=$(cat /sys/fs/cgroup/memory.max /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null | head -1)
CG_CPU=$(cat /sys/fs/cgroup/cpu.max /sys/fs/cgroup/cpu/cpu.cfs_quota_us 2>/dev/null | head -1)
echo "cpus (nproc): $(nproc), memory (_PHYS_PAGES): $(( $(getconf _PHYS_PAGES) * $(getconf PAGE_SIZE) / 1024 / 1024 ))MB"
echo "cgroup memory: ${CG_MEM:-none}, cgroup cpu: ${CG_CPU:-none}"
echo "building with -j$MAKE_JOBS"

if [ -f patched_dependencies* ]
then
        echo
        echo "you are not in a clean repository state, build will fail, please run ./clean"
        echo "or excecute the specific build script out of build_scripts that you want to rebuid"
        echo
        exit 1
fi

#
# Per-build logs kept out of the CI console -> to long.
#
mkdir -p logs

# The below shell re-direct routes a build's full stdout into its logfile
# via gen_output.sh - console gets only progress markers - while preserving its exit
# code

#run all builds in order
for build in build_scripts/0*.sh; do
   name=$(basename "$build" .sh)
   echo
   echo "#### $build ####"
   echo
   ((((bash "$build"; echo $? >&3) 2>logs/${name}.err | ./log_wrap.sh logs/${name}.log >&4) 3>&1) | (read res; exit $res)) 4>&1
   if [ $? -ne 0 ]
   then
      echo "FAILED: $build (full log in logs/${name}.log, logs/${name}.err artifacts)"
      echo "--- tail logs/${name}.log ---"; tail -n 40 logs/${name}.log
      echo "--- tail logs/${name}.err ---"; tail -n 40 logs/${name}.err
      exit 1
   fi
done

echo
echo "build done, for linker test run './test'"
echo