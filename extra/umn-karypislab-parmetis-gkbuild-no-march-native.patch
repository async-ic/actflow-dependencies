Same as the metis patch: gkbuild.cmake appends -march=native after the CFLAGS
-march=${ARCH_LEVEL}, tuning parmetis to the build runner instead of the packaged
baseline, and on aarch64 gcc forwards its native expansion
(-march=armv8-a+flagm2+lse+...) to an assembler that does not know those extension
names. Drop the flag, CFLAGS sets the baseline.

--- conf/gkbuild.cmake
+++ conf/gkbuild.cmake
@@ -28,12 +28,10 @@
 if(CMAKE_COMPILER_IS_GNUCC)
 # GCC opts.
   set(GK_COPTIONS "${GK_COPTIONS} -std=c99 -fno-strict-aliasing")
-# -march=native is not a valid flag on PPC:
-if(CMAKE_SYSTEM_PROCESSOR MATCHES "power|ppc|powerpc|ppc64|powerpc64" OR (APPLE AND CMAKE_OSX_ARCHITECTURES MATCHES "ppc|ppc64"))
-  set(GK_COPTIONS "${GK_COPTIONS} -mtune=native")
-else()
-  set(GK_COPTIONS "${GK_COPTIONS} -march=native")
-endif()
+# no -march/-mtune=native: the package is built once per ARCH_LEVEL baseline and
+# must run on every CPU of that level; on aarch64 gcc additionally forwards the
+# native -march expansion to the assembler, which rejects the extension names.
+# the -march baseline comes from CFLAGS.
   if(NOT MINGW)
       set(GK_COPTIONS "${GK_COPTIONS} -fPIC")
   endif(NOT MINGW)
